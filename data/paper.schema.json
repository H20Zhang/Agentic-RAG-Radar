{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/H20Zhang/Agentic-RAG-Radar/blob/main/data/paper.schema.json",
  "title": "Agentic RAG Radar Paper Record",
  "description": "V2 time/map fields are all-or-none; optional direction_keys binds native rolling-period supports to stable direction metadata.",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "anyOf": [
          {"required": ["published_at"]},
          {"required": ["first_seen_at"]},
          {"required": ["radar_published_at"]},
          {"required": ["time_provenance"]},
          {"required": ["map_delta"]},
          {"required": ["direction_keys"]}
        ]
      }
    },
    {
      "required": ["published_at", "first_seen_at", "radar_published_at", "time_provenance", "map_delta"],
      "properties": {
        "published_at": {"type": "string", "format": "date"},
        "first_seen_at": {"type": "null"},
        "radar_published_at": {"type": "null"},
        "time_provenance": {"const": "legacy_unknown"}
      }
    },
    {
      "required": ["published_at", "first_seen_at", "radar_published_at", "time_provenance", "map_delta"],
      "properties": {
        "published_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "first_seen_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "radar_published_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "time_provenance": {"const": "native_v2"}
      }
    }
  ],
  "allOf": [
    {
      "if": {"required": ["direction_keys"]},
      "then": {
        "properties": {
          "time_provenance": {"const": "native_v2"}
        }
      }
    }
  ],
  "required": [
    "id",
    "title",
    "authors",
    "first_seen",
    "published",
    "urls",
    "primary_category",
    "tags",
    "relevance",
    "importance",
    "visual_explainer",
    "analysis"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "arxiv_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "first_seen": {"type": "string", "format": "date"},
    "published": {"type": "string", "format": "date"},
    "published_at": {"type": ["string", "null"]},
    "first_seen_at": {"type": ["string", "null"]},
    "radar_published_at": {"type": ["string", "null"]},
    "time_provenance": {"enum": ["native_v2", "legacy_unknown"]},
    "map_delta": {"enum": ["none", "early_signal", "reinforces", "revises", "splits", "retires"]},
    "direction_keys": {
      "description": "Non-empty unique stable keys for every rolling-period direction this native-v2 record supports.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
    },
    "updated": {"type": ["string", "null"], "format": "date"},
    "venue": {"type": ["string", "null"]},
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper"],
      "properties": {
        "paper": {"type": "string", "format": "uri"},
        "pdf": {"type": ["string", "null"], "format": "uri"},
        "code": {"type": ["string", "null"], "format": "uri"},
        "project": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "primary_category": {
      "enum": [
        "planning_query_formulation",
        "retrieval_tool_use",
        "iterative_reasoning_verification",
        "multi_agent_orchestration",
        "learning_optimization",
        "evaluation_analysis"
      ]
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "benchmarks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relevance": {"type": "number", "minimum": 0, "maximum": 1},
    "importance": {"type": "integer", "minimum": 1, "maximum": 5},
    "visual_explainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question", "takeaway", "compared_with", "renderer", "status", "image_path", "prompt_path", "artifact_path"],
      "properties": {
        "type": {
          "enum": [
            "agent_loop",
            "retrieval_interface",
            "state_progression",
            "trajectory_learning",
            "evidence_failure_map",
            "taxonomy_map"
          ]
        },
        "question": {"type": "string"},
        "takeaway": {"type": "string"},
        "compared_with": {"type": "string"},
        "full_text_grounded": {"type": "boolean"},
        "renderer": {"enum": ["gpt-image-gen", "other"]},
        "status": {"enum": ["pending", "generated", "needs_regeneration"]},
        "master_image_path": {"type": ["string", "null"]},
        "image_path": {"type": ["string", "null"]},
        "prompt_path": {"type": ["string", "null"]},
        "artifact_path": {"type": ["string", "null"]}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tldr",
        "problem",
        "core_idea",
        "agent_loop",
        "retrieval_design",
        "compared_to",
        "evidence",
        "why_it_matters",
        "limitations",
        "confidence"
      ],
      "properties": {
        "tldr": {"type": "string"},
        "problem": {"type": "string"},
        "core_idea": {"type": "string"},
        "agent_loop": {"type": "string"},
        "retrieval_design": {"type": "string"},
        "compared_to": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "string"},
        "why_it_matters": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "discovered_via": {"type": "array", "items": {"type": "string"}},
        "full_text_checked": {"type": "boolean"},
        "code_link_verified": {"type": "boolean"},
        "last_reviewed": {"type": "string", "format": "date"}
      }
    }
  }
}
